PORT=5000
FRONTEND_URL=http://localhost:5173
MONGO_URL=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
EMAIL_USER=your_email_address
EMAIL_PASS=your_email_app_password
# Support chat assistant: a free Gemini API key from https://aistudio.google.com/apikey.
# Leave empty to turn the assistant off; customers can still open tickets on the Support page.
GEMINI_API_KEY=
# Optional: different Gemini models than the defaults (gemini-3.8-flash, and gemini-3.5-flash
# when that one is overloaded). Both must be Gemini 3 models.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=ANM-Shop <no-reply@your-verified-domain.com>
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard -> Webhooks: URL https://<your-api-domain>/api/payment/webhook,
# event "payment.captured". Paste the secret you set there:
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Reverse proxies in front of the API: 1 for Render/Railway/most hosts, 0 for none
TRUST_PROXY=1
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
ADMIN_EMAIL=
# Shipping in rupees: SHIPPING_FEE is charged when the items total is below FREE_SHIPPING_ABOVE.
# Defaults: 49 and 499.
SHIPPING_FEE=
FREE_SHIPPING_ABOVE=
