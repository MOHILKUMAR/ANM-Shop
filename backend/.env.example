PORT=5000
FRONTEND_URL=http://localhost:5173
MONGO_URL=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
EMAIL_USER=your_email_address
EMAIL_PASS=your_email_app_password
# Support chat assistant (Claude API key from console.anthropic.com). Leave empty to turn the
# assistant off; customers can still open tickets on the Support page.
ANTHROPIC_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=ANM-Shop <no-reply@your-verified-domain.com>
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard -> Webhooks: URL https://<your-api-domain>/api/payment/webhook,
# event "payment.captured". Paste the secret you set there:
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Reverse proxies in front of the API: 1 for Render/Railway/most hosts, 0 for none
TRUST_PROXY=1
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
ADMIN_EMAIL=
